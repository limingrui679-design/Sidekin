# Sidekin ships a deliberately large visual corpus. Keep these paths in Git
# LFS so ordinary Git history stores small pointers instead of every PNG blob.
Sources/SidekinApp/Resources/Characters/*.png filter=lfs diff=lfs merge=lfs -text
ArtSources/FiveStage/**/*.png filter=lfs diff=lfs merge=lfs -text
ArtSources/AuditReplacements/**/*.png filter=lfs diff=lfs merge=lfs -text
ArtSources/AuditSheets/*.png filter=lfs diff=lfs merge=lfs -text
ArtSources/READMEHero/*.png filter=lfs diff=lfs merge=lfs -text
# Keep the unfinished 200-lineage expansion out of ordinary Git object history
# when it is reviewed and added in a later release.
ArtSources/Expansion200/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/readme/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/readme/*.png filter=lfs diff=lfs merge=lfs -text
